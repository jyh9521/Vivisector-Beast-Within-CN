procedure message_more_to_go
{
   ax = check_dead_id_alive
   stri "还剩 %d 个……"
   gui_eventicon = icon_INFO
   gui_eventtime = 5
   gui_eventsound = 1
   event_message0 = str_ax
   event_message1 ""
   event_message2 ""
   event_message3 ""
   event_message4 "" 
}



procedure message_grenadil_wp
{
  ax = check_dead_id_alive
  stri " 还有 %d 只榴弹兽存活……"
  gui_eventicon = icon_INFO
  gui_eventtime = 5
  gui_eventsound = 1
  event_message0 "装备榴弹发射器的怪物仍然控制着"
  event_message1 "这片区域。杀光它们，我就打开大门。"
  event_message2 = str_ax
  event_message3 ""
  event_message4 ""
}

