procedure proc_get_interface
{
  sound sound_hud_beep

  gui_eventicon = icon_INFO
  gui_eventtime = 5
  event_message0 "*TransLoader系统启动……"
  event_message1 "============================"
  event_message2 "启动程序已初始化"
  event_message3 "请稍候"
  event_message4 "============================"
  ax = 3
  delayedcommand "call proc_get_health"
}


procedure proc_get_health
{
  gui_support_health=1

  sound sound_hud_pick

  gui_eventtime = 5
  event_message0 "正在注册组件："
  event_message1 " ======================="
  event_message2 " * 生命维持系统…… 已就绪"
  event_message3 ""
  event_message4 ""
  ax = 1
  delayedcommand "call proc_get_ammo"
}

