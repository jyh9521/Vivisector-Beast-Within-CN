procedure UpgradeMod_Start
{
   gui_eventicon = icon_INFO
   gui_eventtime = 20

   event_message0 = "* 升级模块"
   event_message1 ""
   event_message2 ""
   event_message3 ""
   event_message4 ""

   call UpgradeMod_Online
   call pics_on
}

procedure UpgradeMod_Online
{
  str_ax = "."
  _call strcat(&event_message0, &str_ax)

  str_ax = event_message0
  _call strlen
  if (result > 32) 
  {
     str_ax = "已就绪"
     _call strcat(&event_message0, &str_ax)
     cur_up = 0
     sound Sound_Hud_Pick
     call UpgradeMod_Get
     exit
  }
    
  ax = 3.2/result
  delayedcommand "call UpgradeMod_Online"
}